generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
  BRIGADIER
}

enum CategoryKind {
  EQUIPMENT
  PERSONNEL
  OTHER
}

enum ItemKind {
  EQUIPMENT
  PERSONNEL
  SERVICE
  CONSUMABLE
  COMPONENT
  OTHER
}

enum DayMode {
  HALF_EXTRA
  FULL_DAYS
  FIXED1
  FIXED2
}

/// Владелец оборудования: Шоу-Мастер / Диаком / НеИвент
enum CatalogOwner {
  SHOW_MASTER
  DIAKOM
  NE_EVENT
}

enum QuoteLifecycle {
  CALCULATED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum BlockType {
  SECTION
  ITEM
  NOTE
  KIT_HEADER
}

enum NotificationType {
  INVOICE_DUE
  SYSTEM
  EVENT_CREATED
  EVENT_ASSIGNED
  CHAT_MESSAGE
  /// Смета подтверждена — бригадиру нужна бригада монтажников
  MOUNT_CONFIRMED
  /// Задача на дату прошла, не отмечена выполненной
  TASK_OPEN
}

/// Погода на дашборде: город Иркутск или Иркутская область
enum WeatherPlace {
  IRKUTSK
  IRKUTSK_OBLAST
}

enum PayMode {
  SHIFT
  HOURLY
}

/// EVENT = участник шоу; MOUNT = монтажник (не путать)
enum AssignmentKind {
  EVENT
  MOUNT
}

/// Режим распределения строки в калькуляции
enum CalcLineMode {
  SHARE
  AMOUNT
}

enum SpecOverrideAction {
  HIDE
  SET_QTY
  RENAME
  SET_COMMENT
  REPLACE
}

enum SpecExtraType {
  SECTION
  ITEM
}

/// Запись календаря вне сметы: аренда / задача / выходной
enum CalendarEntryKind {
  RENTAL
  TASK
  DAY_OFF
}

enum EquipmentRepairStatus {
  OPEN
  CLOSED
}

enum PayoutKind {
  STAFF_MONTH
  FREELANCER_EVENT
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  name          String
  firstName     String           @default("")
  lastName      String           @default("")
  patronymic    String           @default("")
  phone         String           @default("")
  comment       String           @default("")
  passwordHash  String
  role          Role             @default(EMPLOYEE)
  active        Boolean          @default(true)
  monthlySalary Float            @default(0)
  /// Агентские менеджера проекта, % от (выручка − расходы − ЗП − монтажные). База 5.
  agencyPercent Float            @default(5)
  /// К каким фирмам относится сотрудник (ШМ / ДК / NE) — для учёта ЗП в доходности
  owners        CatalogOwner[]   @default([])
  /// IANA, по умолчанию Иркутск (UTC+8)
  timezone      String           @default("Asia/Irkutsk")
  weatherPlace  WeatherPlace     @default(IRKUTSK)
  /// Раздел «Оплаты»: ЗП за прошлый месяц и выплаты фрилансерам
  canAccessPayments Boolean      @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  quotes             Quote[]
  quoteTemplates     QuoteTemplate[]
  notifications      Notification[]
  specialties        UserSpecialty[]
  assignments        QuoteAssignment[]
  quoteComments      QuoteComment[]
  quoteAttachments   QuoteAttachment[]
  equipmentDocuments EquipmentDocument[]
  equipmentRepairsReported EquipmentRepair[] @relation("EquipmentRepairReportedBy")
  equipmentRepairsResolved EquipmentRepair[] @relation("EquipmentRepairResolvedBy")
  calendarEntriesCreated      CalendarEntry[]           @relation("CalendarEntryCreatedBy")
  calendarEntriesResponsible  CalendarEntry[]           @relation("CalendarEntryResponsible")
  calendarEntriesCompleted    CalendarEntry[]           @relation("CalendarEntryCompletedBy")
  calendarEntryAssignments    CalendarEntryAssignee[]
  quoteSnapshotsCreated       QuoteSnapshot[]           @relation("QuoteSnapshotCreatedBy")
  quoteAuditEvents            QuoteAuditEvent[]         @relation("QuoteAuditEventActor")
  specRevisionsCreated        SpecRevision[]            @relation("SpecRevisionCreatedBy")
  payouts                     Payout[]                  @relation("UserPayouts")
  payoutsMarked               Payout[]                  @relation("PayoutPaidBy")
}

model Specialty {
  id          String           @id @default(cuid())
  name        String           @unique
  sortOrder   Int              @default(0)
  hourlyRate  Float            @default(0)
  shiftRate   Float            @default(0)
  description String           @default("")
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users         UserSpecialty[]
  freelancers   FreelancerSpecialty[]
  assignments   QuoteAssignment[]
  catalogItems  SpecialtyCatalogItem[]
}

/// Услуги / персонал каталога, из которых в спецификации появляется слот этой специальности.
model SpecialtyCatalogItem {
  id            String      @id @default(cuid())
  specialtyId   String
  specialty     Specialty   @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  catalogItemId String      @unique
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([specialtyId])
}

model UserSpecialty {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialtyId String
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  hourlyRate  Float     @default(0)
  shiftRate   Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, specialtyId])
  @@index([specialtyId])
}

model QuoteAssignment {
  id           String    @id @default(cuid())
  quoteId      String
  quote        Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  /// null для фрилансера (без учётки в системе)
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialtyId  String
  specialty    Specialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  payMode      PayMode   @default(SHIFT)
  hours        Float?
  rateOverride Float?
  /// Премиальные за мероприятие (в калькуляции)
  bonus        Float     @default(0)
  /// Монтажные по факту (в калькуляции, на сотрудника)
  montageAmount Float    @default(0)
  /// Фрилансер: строка без User, ФИО вручную
  isFreelancer   Boolean        @default(false)
  freelancerName String         @default("")
  /// Фирма для ЗП фрилансера (ШМ / ДК / NE); у штатных — с User.owners
  owners         CatalogOwner[] @default([])
  /// Участник шоу vs монтажник. Один человек может быть и EVENT, и MOUNT.
  kind           AssignmentKind @default(EVENT)
  /// Зона сметы, из которой пришёл слот (можно сменить вручную).
  zoneId         String?
  zone           QuoteZone?     @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  /// Рабочий день мероприятия (1-based). null = все дни / монтажник.
  dayIndex       Int?
  /// Монтажник был на монтаже (для расчёта монтажных).
  onMount        Boolean  @default(true)
  /// Монтажник был на демонтаже.
  onDemount      Boolean  @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([quoteId, kind])
  @@index([quoteId, kind, dayIndex])
  @@index([userId])
  @@index([specialtyId])
  @@index([zoneId])
}

model CatalogCategory {
  id            String            @id @default(cuid())
  name          String
  path          String            @unique
  parentId      String?
  parent        CatalogCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      CatalogCategory[] @relation("CategoryTree")
  kind          CategoryKind      @default(EQUIPMENT)
  subtotalLabel String            @default("")
  sortOrder     Int               @default(0)
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  items         CatalogItem[]
  kits          Kit[]

  @@index([parentId])
}

model CatalogItem {
  id               String          @id @default(cuid())
  categoryId       String
  category         CatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name             String
  model            String?
  manufacturer     String?
  basePrice        Float           @default(0)
  cashlessOverride Float?
  estimatedValue   Float?
  /// Себестоимость единицы (закуп Zoom / лицензии). Null = не задана.
  costPrice        Float?
  stockQty         Int             @default(0)
  width            Float?
  height           Float?
  depth            Float?
  power            Float?
  weight           Float?
  comment          String?
  photoPath        String?
  /// Публичный числовой ID карточки оборудования (как в QR-референсе)
  equipmentCode    Int?            @unique
  /// Один или несколько владельцев (общая покупка — 2–3 тега)
  owners           CatalogOwner[]  @default([])
  dayMode          DayMode         @default(HALF_EXTRA)
  itemKind         ItemKind        @default(EQUIPMENT)
  active           Boolean         @default(true)
  /// Показывать позицию менеджеру в каталоге сметы. false = конструктив: комплекты и спека.
  showInCatalog    Boolean         @default(true)
  sortOrder        Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  quoteBlocks      QuoteBlock[]
  kitComponents    KitComponent[]
  calendarEntryLines CalendarEntryLine[]
  equipmentUnits   EquipmentUnit[]
  equipmentDocuments EquipmentDocument[]
  specialtyLinks     SpecialtyCatalogItem[]

  @@index([categoryId])
  @@index([itemKind])
  @@index([name])
  @@index([showInCatalog])
}

model EquipmentUnit {
  id            String      @id @default(cuid())
  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  /// Порядковый номер экземпляра внутри SKU (1..N)
  unitNumber    Int
  /// Непрозрачный токен для публичного URL /q/[token]
  qrToken       String      @unique
  label         String?
  /// Склад единицы: ШМ / ДК / NE. Одна фирма — один склад.
  owner         CatalogOwner?
  active        Boolean     @default(true)
  /// Списана в ремонт — не участвует в складском остатке
  inRepair      Boolean     @default(false)
  /// Списание: DAMAGED | LOST
  writeOffReason  String?
  writeOffComment String    @default("")
  writeOffAt      DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  repairs       EquipmentRepair[]

  @@unique([catalogItemId, unitNumber])
  @@index([catalogItemId])
  @@index([inRepair])
  @@index([owner])
}

model EquipmentDocument {
  id            String      @id @default(cuid())
  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  uploaderId    String
  uploader      User        @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  filename      String
  mimeType      String
  size          Int
  storagePath   String
  description   String?
  createdAt     DateTime    @default(now())

  @@index([catalogItemId])
  @@index([uploaderId])
}

model EquipmentRepair {
  id           String                 @id @default(cuid())
  unitId       String
  unit         EquipmentUnit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  status       EquipmentRepairStatus  @default(OPEN)
  faultType    String
  comment      String                 @default("")
  reportedById String
  reportedBy   User                   @relation("EquipmentRepairReportedBy", fields: [reportedById], references: [id], onDelete: Restrict)
  reportedAt   DateTime               @default(now())
  /// Заключение сервиса при возврате на склад
  resolutionComment String            @default("")
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?                  @relation("EquipmentRepairResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  photos       EquipmentRepairPhoto[]

  @@index([unitId])
  @@index([status])
  @@index([reportedAt])
}

model EquipmentRepairPhoto {
  id          String          @id @default(cuid())
  repairId    String
  repair      EquipmentRepair @relation(fields: [repairId], references: [id], onDelete: Cascade)
  filename    String
  mimeType    String
  size        Int
  storagePath String
  createdAt   DateTime        @default(now())

  @@index([repairId])
}

model Kit {
  id          String           @id @default(cuid())
  name        String
  description String?
  categoryId  String?
  category    CatalogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  basePrice   Float?
  active      Boolean          @default(true)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  components  KitComponent[]
  quoteBlocks QuoteBlock[]
}

model KitComponent {
  id            String      @id @default(cuid())
  kitId         String
  kit           Kit         @relation(fields: [kitId], references: [id], onDelete: Cascade)
  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  qty           Float       @default(1)

  @@unique([kitId, catalogItemId])
  @@index([catalogItemId])
}

model Client {
  id              String          @id @default(cuid())
  companyName     String
  contactName     String          @default("")
  phone           String          @default("")
  email           String          @default("")
  comment         String          @default("")
  inn             String          @default("")
  legalAddress    String          @default("")
  legalDetails    String          @default("")
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  quotes          Quote[]
  calendarEntries CalendarEntry[]

  @@index([companyName])
  @@index([inn])
}

/// Справочник фрилансеров: ФИО + статистика выплат по назначениям в сметах.
model Freelancer {
  id          String                @id @default(cuid())
  name        String
  comment     String                @default("")
  active      Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  specialties FreelancerSpecialty[]

  @@index([name])
  @@index([active])
}

model FreelancerSpecialty {
  id           String     @id @default(cuid())
  freelancerId String
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  specialtyId  String
  specialty    Specialty  @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  hourlyRate   Float      @default(0)
  shiftRate    Float      @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([freelancerId, specialtyId])
  @@index([specialtyId])
}

/// Отметка выплаты: оклад штата за месяц или оплата фрилансеру с мероприятия.
model Payout {
  id           String     @id @default(cuid())
  /// staff:{userId}:{YYYY-MM} | freelancer:{assignmentId}
  sourceKey    String     @unique
  kind         PayoutKind
  /// YYYY-MM
  periodYm     String
  userId       String?
  user         User?      @relation("UserPayouts", fields: [userId], references: [id], onDelete: SetNull)
  assignmentId String?
  quoteId      String?
  payeeName    String
  amount       Float
  breakdown    Json?
  paid         Boolean    @default(false)
  paidAt       DateTime?
  paidById     String?
  paidBy       User?      @relation("PayoutPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userId, paid])
  @@index([kind, paid])
  @@index([periodYm])
  @@index([paidAt])
}

/// Юрлицо исполнителя для договор/счёт/акт. Рядом с CatalogOwner, не вместо тегов склада.
model LegalEntity {
  id            String                  @id @default(cuid())
  shortName     String
  fullName      String                  @default("")
  inn           String                  @unique
  ogrnip        String                  @default("")
  legalAddress  String                  @default("")
  actualAddress String                  @default("")
  phone         String                  @default("")
  email         String                  @default("")
  /// Опциональная привязка к тегу склада (SHM / DK / NE). Склад по-прежнему CatalogOwner на позициях.
  catalogOwner  CatalogOwner?
  signatoryName String                  @default("")
  sealPath      String?
  signaturePath String?
  active        Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  bankAccounts  LegalEntityBankAccount[]

  @@index([catalogOwner])
  @@index([active])
}

model LegalEntityBankAccount {
  id            String      @id @default(cuid())
  legalEntityId String
  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  label         String      @default("")
  bankName      String      @default("")
  account       String
  corrAccount   String      @default("")
  bik           String      @default("")
  isDefault     Boolean     @default(false)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([legalEntityId, account])
  @@index([legalEntityId])
}

model Venue {
  id        String       @id @default(cuid())
  name      String
  address   String       @default("")
  mapUrl    String       @default("")
  comment   String       @default("")
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  photos    VenuePhoto[]
  quotes    Quote[]

  @@index([name])
  @@index([address])
}

model Vehicle {
  id                 String   @id @default(cuid())
  plateNumber        String   @unique
  make               String   @default("")
  model              String   @default("")
  series             String   @default("")
  certificateNumber  String   @default("")
  fuelConsumption    Float    @default(0)
  mileage            Float    @default(0)
  operatingRules     String   @default("")
  comment            String   @default("")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([make])
  @@index([model])
}

model VenuePhoto {
  id          String   @id @default(cuid())
  venueId     String
  venue       Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  filename    String
  mimeType    String
  size        Int
  storagePath String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([venueId])
}

model Quote {
  id              String            @id @default(cuid())
  proposalNumber  String            @default("90")
  eventName       String            @default("")
  date            String            @default("")
  eventDate       DateTime?
  /// Начало монтажа (ДД.ММ.ГГГГ), отдельно от дат мероприятия
  mountDate       String            @default("")
  /// Длительность монтажа в днях (включительно)
  mountDurationDays Int             @default(1)
  /// Начало демонтажа (ДД.ММ.ГГГГ)
  demountDate     String            @default("")
  /// Длительность демонтажа в днях (включительно)
  demountDurationDays Int           @default(1)
  time            String            @default("")
  place           String            @default("")
  venueId         String?
  venueRef        Venue?            @relation(fields: [venueId], references: [id], onDelete: SetNull)
  client          String            @default("")
  clientId        String?
  clientRef       Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Контакт, с которого поступила заявка на КП: телефон, Telegram и примечание
  requestContact  String            @default("")
  managerName     String            @default("")
  cashless        Boolean           @default(true)
  /// % начисления безнала к базовой (наличной) цене. База 10 → цена / 0.9
  cashlessPercent Float             @default(10)
  durationDays    Int               @default(1)
  notes           String[]          @default([])
  brief           String            @default("")
  discountPercent Float             @default(0)
  lifecycle       QuoteLifecycle    @default(CALCULATED)
  invoiceRequired Boolean           @default(false)
  invoiceSent     Boolean           @default(false)
  paid            Boolean           @default(false)
  paymentComment  String            @default("")
  /// true = доли компаний заданы вручную (QuoteCalcShare), иначе — авто из владельцев позиций
  sharesCustom    Boolean           @default(false)
  /// Сколько слотов уже импортировано из сметы. Ключ: "MOUNT:specialtyId" → qty.
  /// Не уменьшается: удалённые слоты не добираются повторно.
  assignmentImportWatermark Json    @default("{}")
  ownerId         String
  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  blocks          QuoteBlock[]
  zones           QuoteZone[]
  notifications   Notification[]
  assignments     QuoteAssignment[]
  /// Порядок строк спецификации (ключи SpecLine.key)
  specLineOrder   String[]          @default([])
  specOverrides   SpecOverride[]
  specExtras      SpecExtraBlock[]
  comments        QuoteComment[]
  attachments     QuoteAttachment[]
  calcShares         QuoteCalcShare[]
  extraExpenses      QuoteExtraExpense[]
  calcLineOverrides  QuoteCalcLineOverride[]
  snapshots          QuoteSnapshot[]
  auditEvents        QuoteAuditEvent[]
  specRevisions      SpecRevision[]

  @@index([ownerId])
  @@index([eventDate])
  @@index([lifecycle])
  @@index([clientId])
  @@index([venueId])
}

/// Доля компании в калькуляции сметы (когда sharesCustom = true)
model QuoteCalcShare {
  id        String       @id @default(cuid())
  quoteId   String
  quote     Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  company   CatalogOwner
  percent   Float        @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([quoteId, company])
  @@index([quoteId])
}

/// Переопределение владельцев / сумм по строке сметы в калькуляции
model QuoteCalcLineOverride {
  id           String       @id @default(cuid())
  quoteId      String
  quote        Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  blockId      String
  mode         CalcLineMode @default(SHARE)
  /// true = owners заданы вручную; иначе берём из каталога
  ownersCustom Boolean      @default(false)
  owners       CatalogOwner[] @default([])
  amountShowMaster Float    @default(0)
  amountDiakom     Float    @default(0)
  amountNeEvent    Float    @default(0)
  /// Себестоимость строки в калькуляции (абсолют). Null = каталог / дефолт (услуга 0).
  costOverride     Float?
  /// Монтажные по факту калькуляции (отдельно от суммы позиции)
  montageAmount    Float    @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([quoteId, blockId])
  @@index([quoteId])
  @@index([blockId])
}

/// Доп. расходы проекта (транспорт, питание и т.п.)
model QuoteExtraExpense {
  id        String        @id @default(cuid())
  quoteId   String
  quote     Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  name      String
  amount    Float         @default(0)
  /// SHARE: owners пусто = по долям выручки; owners заданы = поровну между ними.
  /// AMOUNT: натуральные суммы в amount*
  mode      CalcLineMode  @default(SHARE)
  /// @deprecated используйте owners; оставлено для совместимости
  company   CatalogOwner?
  owners    CatalogOwner[] @default([])
  amountShowMaster Float  @default(0)
  amountDiakom     Float  @default(0)
  amountNeEvent    Float  @default(0)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([quoteId])
}

model QuoteZone {
  id        String       @id @default(cuid())
  quoteId   String
  quote     Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int          @default(0)
  /// false = выключена (фаза 1.2): не в сумме и не в резерве. Пока не скрывать в UI.
  active    Boolean      @default(true)
  /// 1-based дни мероприятия, когда зона работает. Пусто = все дни.
  workingDayIndexes Int[] @default([])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  blocks      QuoteBlock[]
  assignments QuoteAssignment[]

  @@index([quoteId])
}

/// Снимок тела сметы (meta + zones + blocks). Хранить не больше 3 на quote.
model QuoteSnapshot {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  title       String   @default("")
  payload     Json
  createdById String?
  createdBy   User?    @relation("QuoteSnapshotCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([quoteId, createdAt])
  @@index([createdById])
}

/// Журнал правок сметы. UI лога — фаза 1.4.
model QuoteAuditEvent {
  id        String   @id @default(cuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation("QuoteAuditEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  summary   String
  diff      Json?
  createdAt DateTime @default(now())

  @@index([quoteId, createdAt])
  @@index([actorId])
}

/// Снимок спецификации. После first-save / import — источник правды для GET.
model SpecRevision {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  title       String   @default("")
  lines       Json
  note        String?
  createdById String?
  createdBy   User?    @relation("SpecRevisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([quoteId, createdAt])
  @@index([createdById])
}

model QuoteTemplate {
  id              String   @id @default(cuid())
  name            String
  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  discountPercent Float    @default(0)
  cashless        Boolean  @default(true)
  cashlessPercent Float    @default(10)
  notes           String[] @default([])
  payload         Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ownerId])
  @@index([name])
}

model SpecOverride {
  id            String             @id @default(cuid())
  quoteId       String
  quote         Quote              @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  deriveKey     String
  action        SpecOverrideAction
  qty           Float?
  name          String?
  /// For REPLACE — new catalog item
  catalogItemId String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([quoteId, deriveKey, action])
  @@index([quoteId])
}

model SpecExtraBlock {
  id            String        @id @default(cuid())
  quoteId       String
  quote         Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  type          SpecExtraType
  sortOrder     Int           @default(0)
  title         String?
  name          String?
  qty           Float         @default(0)
  comment       String        @default("")
  catalogItemId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([quoteId])
}

model QuoteComment {
  id        String   @id @default(cuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String   @default("")
  /// Optional chat image (png/jpeg), stored under uploads/
  imagePath String?
  imageMime String?
  imageName String?
  createdAt DateTime @default(now())

  @@index([quoteId, createdAt])
  @@index([authorId])
}

model QuoteAttachment {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  uploaderId  String
  uploader    User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  filename    String
  mimeType    String
  size        Int
  storagePath String
  /// Этот файл отмечен как отправленный заказчику счёт (не больше одного на смету)
  invoiceSent Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([quoteId])
  @@index([uploaderId])
}

model QuoteBlock {
  id               String       @id @default(cuid())
  quoteId          String
  quote            Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  zoneId           String?
  zone             QuoteZone?   @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  type             BlockType
  sortOrder        Int          @default(0)
  title            String?
  name             String?
  qty              Float        @default(0)
  unitPrice        Float        @default(0)
  cashlessOverride Float?
  dayMode          DayMode      @default(HALF_EXTRA)
  dayCoefOverride  Float?
  catalogItemId    String?
  catalogItem      CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  kitId            String?
  kit              Kit?         @relation(fields: [kitId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([quoteId])
  @@index([zoneId])
  @@index([catalogItemId])
  @@index([kitId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  quoteId   String?
  quote     Quote?           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  type      NotificationType @default(SYSTEM)
  title     String
  body      String
  read      Boolean          @default(false)
  calendarEntryId String?
  calendarEntry   CalendarEntry?  @relation(fields: [calendarEntryId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([quoteId])
  @@index([calendarEntryId])
}

model CalendarEntry {
  id                String            @id @default(cuid())
  kind              CalendarEntryKind
  /// День записи (локальная дата без времени)
  date              DateTime          @db.Date
  title             String            @default("")
  note              String            @default("")
  /// Выходной: начало/конец в формате HH:mm
  startTime         String?
  endTime           String?
  /// Аренда: ответственный за выдачу
  responsibleUserId String?
  responsibleUser   User?             @relation("CalendarEntryResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  /// Аренда: клиент, которому выдают оборудование
  clientId          String?
  client            Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdById       String
  createdBy         User              @relation("CalendarEntryCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  completedAt       DateTime?
  completedById     String?
  completedBy       User?             @relation("CalendarEntryCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  lines             CalendarEntryLine[]
  assignees         CalendarEntryAssignee[]
  notifications     Notification[]

  @@index([date])
  @@index([kind, date])
  @@index([createdById])
  @@index([responsibleUserId])
  @@index([completedById])
  @@index([clientId])
}

/// Ключ-значение: мастер-часовой пояс компании и т.п.
model AppSetting {
  key   String @id
  value String
}

model CalendarEntryLine {
  id            String        @id @default(cuid())
  entryId       String
  entry         CalendarEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  catalogItemId String
  catalogItem   CatalogItem   @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  qty           Float         @default(1)

  @@index([entryId])
  @@index([catalogItemId])
  @@unique([entryId, catalogItemId])
}

model CalendarEntryAssignee {
  id      String        @id @default(cuid())
  entryId String
  entry   CalendarEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId  String
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entryId, userId])
  @@index([userId])
}
